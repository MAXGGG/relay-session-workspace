{
  "appId": "io.github.maxggg.zyi",
  "productName": "Zyi",
  "directories": { "app": "build/desktop-app", "output": "release", "buildResources": "assets" },
  "files": ["main.cjs", "package.json", "!node_modules/**/*"],
  "extraResources": [
    { "from": "build/backend", "to": "backend" },
    { "from": "build/backend/node_modules", "to": "backend/node_modules", "filter": ["**/*"] },
    { "from": "build/runtime", "to": "runtime" }
  ],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "Zyi-${version}-${os}-${arch}.${ext}",
  "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.developer-tools",
    "icon": "assets/icon.png",
    "identity": "-",
    "hardenedRuntime": false,
    "notarize": false
  },
  "publish": null
}
